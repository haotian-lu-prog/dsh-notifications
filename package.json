{
  "name": "dsh-notifications",
  "version": "1.0.0",
  "description": "macOS menu bar activity indicator for DeepSeek Harness (community fork of dsh-notify, compatible with DSH 0.1.7-rc.2 and 0.2.0-rc.1)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "native/dsh-notifications-menubar",
    "native/whale.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build:native": "sh scripts/build-native.sh",
    "prepare": "npm run build:native",
    "test": "npm run build:native && node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.2 || ^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "author": "linbin-mk (https://github.com/linbin-mk)",
  "contributors": [
    {
      "name": "Haotian Lu",
      "email": "haotian._.lu@icloud.com",
      "url": "https://github.com/haotian-lu-prog"
    }
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-notifications",
    "dsh-notify",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "macos",
    "menu-bar",
    "menubar",
    "notifications",
    "notify"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haotian-lu-prog/dsh-notifications.git"
  },
  "homepage": "https://github.com/haotian-lu-prog/dsh-notifications#readme",
  "bugs": {
    "url": "https://github.com/haotian-lu-prog/dsh-notifications/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "MIT"
}
